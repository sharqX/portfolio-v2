---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

import Base from "../../layouts/Base.astro";
import Tag from "../../components/Tag.astro";

const posts = (
  await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const slugify = (value: string) =>
  value
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();

const byYear = posts.reduce<Map<number, typeof posts>>((groups, post) => {
  const year = post.data.date.getFullYear();
  const bucket = groups.get(year);
  if (bucket) bucket.push(post);
  else groups.set(year, [post]);
  return groups;
}, new Map());

const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);

const formatter = new Intl.DateTimeFormat("en-GB", {
  day: "2-digit",
  month: "short",
});
---

<Base
  title="Writing"
  description="Posts on cloud infrastructure, containers, deployment pipelines and observability."
>
  <section class="section blog">
    <div class="container">
      <header class="blog__head" data-reveal>
        <p class="eyebrow">Writing</p>
        <h1 class="section-title">Notes from the pipeline</h1>
        <p class="section-lede">
          Write-ups of things I've deployed, broken and fixed — infrastructure,
          containers, delivery pipelines and the observability needed to trust
          any of it. <a href="/rss.xml">Subscribe by RSS</a>.
        </p>
      </header>

      {
        allTags.length > 0 && (
          <div class="filters" data-filter-bar hidden data-reveal>
            <span class="filters__label">Filter</span>
            <button class="chip is-active" type="button" data-filter="all">
              All
            </button>
            {allTags.map((tag) => (
              <button class="chip" type="button" data-filter={slugify(tag)}>
                {tag}
              </button>
            ))}
          </div>
        )
      }

      <p
        class="filters__status mono"
        role="status"
        aria-live="polite"
        data-filter-status
      >
      </p>

      <div class="years">
        {
          years.map(([year, entries], groupIndex) => (
            <section class="year" data-year-group>
              <h2 class="year__label mono">{year}</h2>
              <ul class="year__list">
                {entries.map((post, i) => (
                  <li
                    class="row"
                    data-post
                    data-tags={post.data.tags.map(slugify).join(" ")}
                    data-reveal
                    style={`--index: ${groupIndex + i}`}
                  >
                    <a class="row__link link-plain" href={`/blog/${post.id}`}>
                      <time
                        class="mono row__date"
                        datetime={post.data.date.toISOString()}
                      >
                        {formatter.format(post.data.date)}
                      </time>
                      <span class="row__body">
                        <span class="row__title">{post.data.title}</span>
                        <span class="row__summary">{post.data.summary}</span>
                        <span class="tag-row row__tags">
                          {post.data.tags.map((tag) => (
                            <Tag accent={post.data.accent}>{tag}</Tag>
                          ))}
                        </span>
                      </span>
                      <Icon
                        aria-hidden="true"
                        class="row__arrow"
                        name="ph:arrow-right-bold"
                        width="16"
                        height="16"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>

      <p class="blog__empty" data-empty hidden>
        Nothing filed under that tag yet.
      </p>
    </div>
  </section>
</Base>

<script>
  const bar = document.querySelector<HTMLElement>("[data-filter-bar]");
  const status = document.querySelector<HTMLElement>("[data-filter-status]");
  const empty = document.querySelector<HTMLElement>("[data-empty]");
  const rows = [...document.querySelectorAll<HTMLElement>("[data-post]")];
  const groups = [
    ...document.querySelectorAll<HTMLElement>("[data-year-group]"),
  ];

  if (bar && rows.length > 0) {
    /* Only expose the controls once the script that powers them is running. */
    bar.hidden = false;

    const chips = [...bar.querySelectorAll<HTMLButtonElement>("[data-filter]")];

    const apply = (filter: string) => {
      let shown = 0;

      for (const row of rows) {
        const tags = (row.dataset.tags ?? "").split(" ").filter(Boolean);
        const match = filter === "all" || tags.includes(filter);
        row.hidden = !match;
        if (match) shown += 1;
      }

      for (const group of groups) {
        const visible = group.querySelectorAll<HTMLElement>(
          "[data-post]:not([hidden])",
        );
        group.hidden = visible.length === 0;
      }

      if (empty) empty.hidden = shown > 0;

      if (status) {
        status.textContent =
          filter === "all"
            ? ""
            : `${shown} ${shown === 1 ? "post" : "posts"} tagged.`;
      }

      for (const chip of chips) {
        chip.classList.toggle("is-active", chip.dataset.filter === filter);
      }
    };

    for (const chip of chips) {
      chip.addEventListener("click", () => apply(chip.dataset.filter ?? "all"));
    }
  }
</script>

<style>
  .blog {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) var(--section-py);
  }

  .blog__head {
    max-width: var(--measure-prose);
  }

  .blog__head .section-title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    margin-block-start: clamp(2.5rem, 5vw, 3.5rem);
  }

  .filters__label {
    margin-inline-end: 0.35rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .chip {
    padding: 0.35rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
    color: var(--ink-muted);
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color var(--dur-hover) ease,
      color var(--dur-hover) ease,
      border-color var(--dur-hover) ease,
      transform var(--dur-hover) ease;
  }

  .chip:hover {
    background: var(--surface-key);
    color: var(--ink);
  }

  .chip:active {
    transform: scale(0.98);
  }

  .chip.is-active {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--ink-inverse);
  }

  .filters__status {
    min-height: 1.25rem;
    margin-block-start: 0.75rem;
    font-size: var(--text-micro);
  }

  .years {
    margin-block-start: 1.5rem;
  }

  .year {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block-start: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .year__label {
    padding-block-start: 1.5rem;
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    font-weight: 400;
    font-family: var(--font-mono);
  }

  .year__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .row + .row {
    border-top: 1px solid var(--border);
  }

  .row__link {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1.25rem;
    padding-block: 1.5rem;
    transition: background-color var(--dur-hover) ease;
  }

  .row__link:hover {
    background: color-mix(in srgb, var(--surface-key) 60%, transparent);
  }

  .row__date {
    font-size: var(--text-micro);
    white-space: nowrap;
  }

  .row__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .row__title {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .row__summary {
    color: var(--ink-muted);
    font-size: var(--text-small);
    max-width: 62ch;
  }

  .row__tags {
    margin-block-start: 0.25rem;
  }

  .row__arrow {
    align-self: center;
    color: var(--border);
    transition:
      transform var(--dur-hover) var(--ease-out-expo),
      color var(--dur-hover) ease;
  }

  .row__link:hover .row__arrow {
    transform: translateX(3px);
    color: var(--ink);
  }

  .blog__empty {
    margin-block-start: 3rem;
    color: var(--ink-muted);
  }

  @media (max-width: 720px) {
    .year {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }

    .year__label {
      padding-block-start: 0;
    }

    .row__link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.5rem 1rem;
    }

    .row__date {
      grid-column: 1 / -1;
    }
  }
</style>
