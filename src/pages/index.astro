---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Section from "../components/Section.astro";
import WorkTimeline from "../components/WorkTimeline.astro";
import ProjectList from "../components/ProjectList.astro";
import BlogList from "../components/BlogList.astro";
import Contact from "../components/Contact.astro";

const work = (await getCollection("work")).sort(
  (a, b) => a.data.order - b.data.order,
);

const projects = (
  await getCollection(
    "projects",
    ({ data }) => !data.draft || import.meta.env.DEV,
  )
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const posts = (
  await getCollection("blog", ({ data }) => !data.draft || import.meta.env.DEV)
)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base>
  <Hero />

  <Section id="work" eyebrow="Work" title="Where I've worked">
    <WorkTimeline entries={work} />
  </Section>

  <Section id="projects" eyebrow="Projects" title="Things I've built">
    <ProjectList projects={projects} />
    <p class="more" data-reveal>
      <a class="btn btn--ghost" href="/projects">
        All projects
        <Icon
          is:inline
          aria-hidden="true"
          name="ph:arrow-right"
          width="19"
          height="19"
        />
      </a>
    </p>
  </Section>

  <Section id="blog" eyebrow="Blog" title="Notes from the pipeline">
    <BlogList posts={posts} />
    <p class="more" data-reveal>
      <a class="btn btn--ghost" href="/blog">
        All posts
        <Icon
          is:inline
          aria-hidden="true"
          name="ph:arrow-right"
          width="19"
          height="19"
        />
      </a>
    </p>
  </Section>

  <Section id="contact" eyebrow="Contact" title="Get in touch">
    <Contact />
  </Section>
</Base>

<style>
  .more {
    margin-block-start: 2rem;
  }
</style>
