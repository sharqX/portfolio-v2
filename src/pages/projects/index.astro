---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";

import Base from "../../layouts/Base.astro";
import Tag from "../../components/Tag.astro";

const projects = (
  await getCollection(
    "projects",
    ({ data }) => !data.draft || import.meta.env.DEV,
  )
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const byYear = projects.reduce<Map<number, typeof projects>>(
  (groups, project) => {
    const year = project.data.date.getFullYear();
    const bucket = groups.get(year);
    if (bucket) bucket.push(project);
    else groups.set(year, [project]);
    return groups;
  },
  new Map(),
);

const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);

const formatter = new Intl.DateTimeFormat("en-GB", {
  month: "short",
  year: "numeric",
});
---

<Base
  title="Projects"
  description="Things I've built end to end — infrastructure, containers, deployment pipelines and the write-ups that go with them."
>
  <section class="section blog">
    <div class="container">
      <header class="blog__head" data-reveal>
        <p class="eyebrow">Projects</p>
        <h1 class="section-title">Things I've built</h1>
        <p class="section-lede">
          Each of these has a full write-up covering the architecture, what
          broke, and what I would do differently.
        </p>
      </header>

      <div class="years">
        {
          years.map(([year, entries], groupIndex) => (
            <section class="year">
              <h2 class="year__label mono">{year}</h2>
              <ul class="year__list">
                {entries.map((project, i) => (
                  <li
                    class="row"
                    data-reveal
                    style={`--index: ${groupIndex + i}`}
                  >
                    <a
                      class="row__link link-plain"
                      href={`/projects/${project.id}`}
                    >
                      <time
                        class="mono row__date"
                        datetime={project.data.date.toISOString()}
                      >
                        {formatter.format(project.data.date)}
                      </time>
                      <span class="row__body">
                        <span class="row__title">{project.data.title}</span>
                        <span class="row__summary">{project.data.summary}</span>
                        <span class="tag-row row__tags">
                          {project.data.tags.map((tag) => (
                            <Tag accent={project.data.accent}>{tag}</Tag>
                          ))}
                        </span>
                      </span>
                      <Icon
                        is:inline
                        aria-hidden="true"
                        class="row__arrow"
                        name="ph:arrow-right"
                        width="19"
                        height="19"
                      />
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .blog {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) var(--section-py);
  }

  .blog__head {
    max-width: var(--measure-prose);
  }

  .blog__head .section-title {
    font-size: clamp(2.25rem, 5vw, 3.25rem);
  }

  .years {
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
  }

  .year {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1.5rem;
    padding-block-start: 2.5rem;
    border-top: 1px solid var(--border);
  }

  .year__label {
    padding-block-start: 1.5rem;
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    font-weight: 400;
    font-family: var(--font-mono);
  }

  .year__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .row + .row {
    border-top: 1px solid var(--border);
  }

  .row__link {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1.25rem;
    padding-block: 1.5rem;
    transition: background-color var(--dur-hover) ease;
  }

  .row__link:hover {
    background: color-mix(in srgb, var(--surface-key) 60%, transparent);
  }

  .row__date {
    font-size: var(--text-micro);
    white-space: nowrap;
  }

  .row__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .row__title {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .row__summary {
    color: var(--ink-muted);
    font-size: var(--text-small);
    max-width: 62ch;
  }

  .row__tags {
    margin-block-start: 0.25rem;
  }

  .row__arrow {
    align-self: center;
    color: var(--border);
    transition:
      transform var(--dur-hover) var(--ease-out-expo),
      color var(--dur-hover) ease;
  }

  .row__link:hover .row__arrow {
    transform: translateX(3px);
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .year {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }

    .year__label {
      padding-block-start: 0;
    }

    .row__link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.5rem 1rem;
    }

    .row__date {
      grid-column: 1 / -1;
    }
  }
</style>
