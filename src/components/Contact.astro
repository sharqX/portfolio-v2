---
import { Icon } from "astro-icon/components";
import { site } from "../site.config";
---

<div class="contact">
  <div class="contact__lead" data-reveal>
    <p class="contact__line">
      The fastest way to reach me is email. I read everything, and I answer
      anything that isn't a recruiter template.
    </p>
    <a class="contact__email" href={`mailto:${site.email}`}>{site.email}</a>

    <p class="contact__hint">
      <span>Press</span>
      <kbd>C</kbd>
      <span>to copy the address.</span>
      <button
        class="contact__copy"
        type="button"
        data-copy-email
        data-email={site.email}
      >
        <Icon
          is:inline
          aria-hidden="true"
          name="ph:copy-bold"
          width="14"
          height="14"
        />
        <span data-copy-label>Copy</span>
      </button>
    </p>
    <p
      class="contact__status"
      role="status"
      aria-live="polite"
      data-copy-status
    >
    </p>
  </div>

  <div class="contact__card card" data-reveal style="--index: 1">
    <p class="contact__card-label">Elsewhere</p>
    <ul class="contact__list">
      {
        site.socials.map((social) => (
          <li>
            <a
              class="contact__row link-plain"
              href={social.href}
              rel="noopener noreferrer"
              target="_blank"
            >
              <Icon
                is:inline
                aria-hidden="true"
                name={social.icon}
                width="16"
                height="16"
              />
              <span class="contact__row-label">{social.label}</span>
              <span class="contact__row-handle">{social.handle}</span>
              <Icon
                is:inline
                aria-hidden="true"
                class="contact__row-arrow"
                name="ph:arrow-up-right-bold"
                width="14"
                height="14"
              />
            </a>
          </li>
        ))
      }
      <li>
        <a
          class="contact__row link-plain"
          href={site.resumeViewUrl}
          rel="noopener noreferrer"
          target="_blank"
        >
          <Icon
            is:inline
            aria-hidden="true"
            name="ph:file-text-bold"
            width="16"
            height="16"
          />
          <span class="contact__row-label">Résumé</span>
          <span class="contact__row-handle">PDF</span>
          <Icon
            is:inline
            aria-hidden="true"
            class="contact__row-arrow"
            name="ph:arrow-up-right-bold"
            width="14"
            height="14"
          />
        </a>
      </li>
    </ul>
  </div>
</div>

<script>
  const button = document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const status = document.querySelector<HTMLElement>("[data-copy-status]");
  const label = document.querySelector<HTMLElement>("[data-copy-label]");

  if (button && status && label) {
    const email = button.dataset.email ?? "";
    let resetTimer: number | undefined;

    const copy = async () => {
      try {
        await navigator.clipboard.writeText(email);
        label.textContent = "Copied";
        status.textContent = `${email} copied to clipboard.`;
      } catch {
        status.textContent = `Copying is blocked here — the address is ${email}.`;
      }

      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        label.textContent = "Copy";
        status.textContent = "";
      }, 2400);
    };

    button.addEventListener("click", copy);

    document.addEventListener("keydown", (event) => {
      if (event.key !== "c" && event.key !== "C") return;
      if (event.metaKey || event.ctrlKey || event.altKey) return;

      const target = event.target as HTMLElement | null;
      if (
        target &&
        (target.isContentEditable ||
          ["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName))
      ) {
        return;
      }

      event.preventDefault();
      void copy();
    });
  }
</script>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .contact__line {
    color: var(--ink-muted);
    max-width: 44ch;
  }

  .contact__email {
    display: inline-block;
    margin-block-start: 1.5rem;
    font-family: var(--font-serif);
    font-size: clamp(1.5rem, 3.5vw, 2.25rem);
    letter-spacing: var(--tracking-tight);
    text-decoration-color: var(--ink-muted);
  }

  .contact__hint {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-block-start: 2rem;
    font-size: var(--text-small);
    color: var(--ink-muted);
  }

  .contact__copy {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-inline-start: 0.35rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-button);
    background: var(--surface);
    color: var(--ink);
    font-size: var(--text-micro);
    cursor: pointer;
    transition:
      background-color var(--dur-hover) ease,
      transform var(--dur-hover) ease;
  }

  .contact__copy:hover {
    background: var(--surface-key);
  }

  .contact__copy:active {
    transform: scale(0.98);
  }

  .contact__status {
    min-height: 1.25rem;
    margin-block-start: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--pastel-green-ink);
  }

  .contact__card {
    padding: clamp(1.5rem, 3vw, 2rem);
  }

  .contact__card:hover {
    box-shadow: var(--shadow-flat);
  }

  .contact__card-label {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .contact__list {
    list-style: none;
    padding: 0;
    margin-block-start: 1rem;
  }

  .contact__list li + li {
    border-top: 1px solid var(--border);
  }

  .contact__row {
    display: grid;
    grid-template-columns: auto minmax(0, auto) minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding-block: 0.85rem;
    font-size: var(--text-small);
  }

  .contact__row-handle {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--ink-muted);
    text-align: right;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .contact__row-arrow {
    color: var(--border);
    transition:
      transform var(--dur-hover) var(--ease-out-expo),
      color var(--dur-hover) ease;
  }

  .contact__row:hover .contact__row-arrow {
    transform: translate(2px, -2px);
    color: var(--ink);
  }

  @media (max-width: 820px) {
    .contact {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
