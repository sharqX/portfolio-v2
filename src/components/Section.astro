---
interface Props {
  id: string;
  eyebrow: string;
  title?: string;
  lede?: string;
  class?: string;
}

const { id, eyebrow, title, lede, class: className } = Astro.props;
---

<section id={id} class:list={["section", className]}>
  <div class="container">
    <header class="section-head" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      {title && <h2 class="section-title">{title}</h2>}
      {lede && <p class="section-lede">{lede}</p>}
    </header>
    <slot />
  </div>
</section>

<style>
  .section-head {
    margin-block-end: clamp(2.5rem, 5vw, 4rem);
  }
</style>
