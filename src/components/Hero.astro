---
import { Icon } from "astro-icon/components";
import { site } from "../site.config";

const steps = [
  { stage: "build", command: "astro build", result: "6 pages" },
  { stage: "image", command: "docker build --push", result: "24.1 MB" },
  { stage: "release", command: "compose up -d on ec2", result: "healthy" },
  {
    stage: "verify",
    command: "curl -sI v2.zararsharique.com",
    result: "200 OK",
  },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    {
      site.availability.open && (
        <p class="hero__badge" data-reveal>
          <span class="tag" data-accent="green">
            <span class="hero__dot" aria-hidden="true" />
            {site.availability.label}
          </span>
        </p>
      )
    }

    <h1 id="hero-title" class="hero__title" data-reveal style="--index: 1">
      {site.name},<br />
      <em>software engineer</em> working close to the infrastructure.
    </h1>

    <div class="hero__grid">
      <div class="hero__copy">
        <p class="hero__lede" data-reveal style="--index: 2">
          I build and run the systems software ships on — AWS, Terraform,
          Kubernetes, and the pipelines between them. Most of the work is making
          deployments unremarkable: reproducible to build, quick to observe, and
          cheap to roll back.
        </p>

        <div class="hero__actions" data-reveal style="--index: 3">
          <a
            class="btn btn--primary"
            href={site.resumeUrl}
            rel="noopener noreferrer"
            target="_blank"
          >
            <Icon
              aria-hidden="true"
              name="ph:download-simple-bold"
              width="16"
              height="16"
            />
            Download résumé
          </a>
          <a class="btn btn--ghost" href="/blog">
            Read the writing
            <Icon
              aria-hidden="true"
              name="ph:arrow-right-bold"
              width="16"
              height="16"
            />
          </a>
        </div>

        <ul class="hero__socials" data-reveal style="--index: 4">
          {
            site.socials.map((social) => (
              <li>
                <a
                  class="hero__social link-plain"
                  href={social.href}
                  rel="noopener noreferrer"
                  target="_blank"
                  aria-label={social.label}
                  title={social.label}
                >
                  <Icon
                    aria-hidden="true"
                    name={social.icon}
                    width="17"
                    height="17"
                  />
                </a>
              </li>
            ))
          }
          <li>
            <a
              class="hero__social link-plain"
              href={`mailto:${site.email}`}
              aria-label="Email"
              title="Email"
            >
              <Icon
                aria-hidden="true"
                name="ph:at-bold"
                width="17"
                height="17"
              />
            </a>
          </li>
        </ul>
      </div>

      <div class="hero__window card" data-reveal style="--index: 3">
        <div class="window__bar">
          <span class="window__dots" aria-hidden="true">
            <i></i><i></i><i></i>
          </span>
          <span class="window__title">deploy.yml — v2.zararsharique.com</span>
        </div>
        <div class="window__body">
          <ul class="steps">
            {
              steps.map((step) => (
                <li class="step">
                  <Icon
                    aria-hidden="true"
                    class="step__tick"
                    name="ph:check-bold"
                    width="13"
                    height="13"
                  />
                  <span class="step__stage">{step.stage}</span>
                  <span class="step__command">{step.command}</span>
                  <span class="step__result">{step.result}</span>
                </li>
              ))
            }
          </ul>
          <p class="window__note">
            This site is built, imaged and released by the pipeline described in <a
              href="/blog">the writing</a
            >.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(4rem, 9vw, 7.5rem) var(--section-py);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    gap: clamp(2.5rem, 5vw, 4.5rem);
    align-items: start;
    margin-block-start: clamp(2.5rem, 5vw, 4rem);
  }

  .hero__badge {
    margin-block-end: 1.75rem;
  }

  .hero__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    margin-inline-end: 0.5rem;
  }

  .hero__title {
    font-size: var(--text-hero);
    text-wrap: balance;
  }

  .hero__title em {
    font-style: italic;
    color: var(--ink-muted);
  }

  .hero__lede {
    max-width: 52ch;
    color: var(--ink-muted);
    font-size: 1.0625rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-block-start: 2.25rem;
  }

  .hero__socials {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-block-start: 2.25rem;
  }

  .hero__social {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-button);
    background: var(--surface);
    color: var(--ink);
    transition:
      background-color var(--dur-hover) ease,
      transform var(--dur-hover) ease;
  }

  .hero__social:hover {
    background: var(--surface-key);
    transform: translateY(-1px);
  }

  /* Comfortable 44px hit area on touch; compact for mouse users. */
  @media (pointer: coarse) {
    .hero__social {
      width: 2.75rem;
      height: 2.75rem;
    }
  }

  /* --- Faux window ------------------------------------------------- */

  .hero__window {
    overflow: hidden;
  }

  .window__bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--surface);
  }

  .window__dots {
    display: inline-flex;
    gap: 0.35rem;
  }

  .window__dots i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--window-dot);
  }

  .window__title {
    font-family: var(--font-mono);
    font-size: var(--text-micro);
    color: var(--ink-muted);
  }

  .window__body {
    padding: 1.5rem 1.25rem 1.25rem;
    background: var(--surface-sunken);
  }

  .steps {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.65rem;
  }

  .step {
    display: grid;
    grid-template-columns: auto 4.5rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.65rem;
    font-family: var(--font-mono);
    font-size: var(--text-micro);
  }

  .step__tick {
    color: var(--pastel-green-ink);
  }

  .step__stage {
    color: var(--ink);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
  }

  .step__command {
    color: var(--ink-muted);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .step__result {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .window__note {
    margin-block-start: 1.5rem;
    padding-block-start: 1rem;
    border-top: 1px solid var(--border);
    font-size: var(--text-micro);
    line-height: 1.5;
    color: var(--ink-muted);
  }

  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .step {
      grid-template-columns: auto 4.5rem minmax(0, 1fr) auto;
    }
  }

  @media (max-width: 480px) {
    .step__command {
      display: none;
    }

    .step {
      grid-template-columns: auto 1fr auto;
    }
  }
</style>
