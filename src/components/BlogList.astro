---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";

interface Props {
  posts: CollectionEntry<"blog">[];
}

const { posts } = Astro.props;

const formatter = new Intl.DateTimeFormat("en-GB", {
  day: "2-digit",
  month: "short",
  year: "numeric",
});
---

<ul class="blog-list">
  {
    posts.map((post, i) => (
      <li class="blog-list__row" data-reveal style={`--index: ${i}`}>
        <a class="blog-list__link link-plain" href={`/blog/${post.id}`}>
          <time
            class="mono blog-list__date"
            datetime={post.data.date.toISOString()}
          >
            {formatter.format(post.data.date)}
          </time>
          <span class="blog-list__body">
            <span class="blog-list__title">{post.data.title}</span>
            <span class="blog-list__summary">{post.data.summary}</span>
          </span>
          <Icon
            is:inline
            aria-hidden="true"
            class="blog-list__arrow"
            name="ph:arrow-right"
            width="19"
            height="19"
          />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .blog-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .blog-list__row {
    border-bottom: 1px solid var(--border);
  }

  .blog-list__link {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: 1.5rem;
    transition: background-color var(--dur-hover) ease;
  }

  .blog-list__link:hover {
    background: color-mix(in srgb, var(--surface-key) 60%, transparent);
  }

  .blog-list__date {
    font-size: var(--text-micro);
    white-space: nowrap;
  }

  .blog-list__body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .blog-list__title {
    font-family: var(--font-serif);
    font-size: 1.375rem;
    letter-spacing: var(--tracking-tight);
    line-height: var(--leading-snug);
  }

  .blog-list__summary {
    color: var(--ink-muted);
    font-size: var(--text-small);
    max-width: 62ch;
  }

  .blog-list__arrow {
    align-self: center;
    color: var(--border);
    transition:
      transform var(--dur-hover) var(--ease-out-expo),
      color var(--dur-hover) ease;
  }

  .blog-list__link:hover .blog-list__arrow {
    transform: translateX(3px);
    color: var(--ember-500);
  }

  @media (max-width: 720px) {
    .blog-list__link {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.5rem 1rem;
      padding-inline: 0.25rem;
    }

    .blog-list__date {
      grid-column: 1 / -1;
    }
  }
</style>
